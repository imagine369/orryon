# ── Grok (xAI) — the AI behind orryon ─────────────────────────────────────────
# REQUIRED. Get your API key at: https://console.x.ai
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat, memory extraction, and receipt vision (multimodal).
GROK_MODEL=grok-4.3

# Orryon voice (xAI Voice API — STT/TTS endpoints, not the chat model above).
# TTS voices: ara, eve, leo, rex, sal. See docs/voice-direction.md.
XAI_TTS_VOICE=sal
XAI_TTS_LANGUAGE=en

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In dev mode, an ephemeral secret is auto-generated (tokens won't survive restarts).
JWT_SECRET=

# HMAC signing for expensive routes (/api/chat, /api/voice/*). Stolen session
# cookies alone cannot call these — the client must also hold a per-session key
# from POST /api/auth/sign-key (kept in memory, never in localStorage).
#   off     — local dev only (NODE_ENV=development|dev|local)
#   warn    — log signature failures but do not reject (rollout debugging)
#   enforce — reject unsigned/invalid requests with 401 (REQUIRED in production)
# If unset: off in local dev, enforce in staging/production.
REQUEST_SIGNING_MODE=enforce
# Never set in production — ignored with an error if NODE_ENV=production.
# DISABLE_REQUEST_SIGNING=1

# ── Email / SMTP (for OTP sign-in codes + notifications) ─────────────────────
# REQUIRED for production — without SMTP, users cannot log in.
# If left blank, verification codes are shown on-screen (local dev only).
#
# Production (transactional email — recommended):
#   Resend   : SMTP_HOST=smtp.resend.com       SMTP_PORT=587  (free tier: 3k/month)
#   Postmark : SMTP_HOST=smtp.postmarkapp.com   SMTP_PORT=587
#   SendGrid : SMTP_HOST=smtp.sendgrid.net      SMTP_PORT=587
#
# Personal (fine for low-volume / dev):
#   Gmail    : SMTP_HOST=smtp.gmail.com          SMTP_PORT=587
#              (enable 2FA → App Passwords → paste 16-char password as SMTP_PASS)
#   Outlook  : SMTP_HOST=smtp-mail.outlook.com   SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourname@orryon.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=yourname@orryon.com

# Who receives contact form submissions (defaults to SMTP_USER if not set)
CONTACT_EMAIL=yourname@orryon.com

# ── URLs ──────────────────────────────────────────────────────────────────────
# APP_URL is used for share links and Stripe return URLs.
# FRONTEND_URL is used for CORS and should match where your Next.js app runs.
# Production: set both to your custom domain (e.g. https://orryon.app)
# Custom domain setup:
#   Vercel  → Settings → Domains → add your domain
#   Railway → Settings → Networking → Custom Domain → add api.yourdomain.com
#   Then update NEXT_PUBLIC_API_URL on Vercel to https://api.yourdomain.com
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite file. In production, point this at a persistent volume.
# Railway: attach a volume at /data, then set DB_PATH=/data/finance.db
DB_PATH=finance.db

# ── Security ───────────────────────────────────────────────────────────────────
# Optional Fernet key for encrypting sensitive DB fields at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Secret for waitlist admin routes (/api/admin/waitlist/* — approve links, export).
# REQUIRED on the backend if you use waitlist admin tooling. Set the same value on
# Railway backend (and frontend if DEPLOY.md lists it for your deploy).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_SECRET=

# ── Redis / Upstash (rate limits, session revocation, job queue) ──────────────
# STRONGLY RECOMMENDED in production. Without a shared Redis the backend's
# rate limiters, JWT-revocation cache, HMAC-nonce replay guard, WebSocket
# auth tickets (/ws/chat), and ARQ job queue all fall back to per-process
# memory — which means limits reset on
# every deploy and don't apply across workers. See backend/cache.py.
#
# Provision a free Upstash Redis project at https://console.upstash.com
#
# Backend (FastAPI, redis.asyncio TCP client — set on Railway):
#   REDIS_URL=rediss://default:<token>@<region>.upstash.io:6379
REDIS_URL=
#
# Frontend (Next.js @upstash/redis HTTP client — set on Vercel). Used by the
# edge rate limiter in frontend/src/lib/ratelimit.ts to short-circuit abuse
# on /api/waitlist, /api/contact, /api/auth/login, /api/auth/demo-login
# before it ever reaches the backend.
#   UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
#   UPSTASH_REDIS_REST_TOKEN=<rest token from the Upstash console>

# ── Stripe (subscription billing) ─────────────────────────────────────────────
# Set up at https://dashboard.stripe.com
# Test keys: sk_test_ / pk_test_    Live keys: sk_live_ / pk_live_
# For production: use LIVE keys, LIVE price IDs, and a LIVE webhook secret.
# Webhook endpoint: https://YOUR_BACKEND_URL/api/stripe/webhook
# Events to forward: checkout.session.completed, customer.subscription.updated,
#   customer.subscription.deleted, customer.subscription.paused, invoice.payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Tier price IDs (Railway backend)
STRIPE_PRICE_PRO_MONTHLY=price_xxx
STRIPE_PRICE_PRO_ANNUAL=price_xxx
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_ANNUAL=price_xxx
STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=price_xxx
STRIPE_PRICE_PREMIUM_PLUS_ANNUAL=price_xxx

# ── Plaid (bank account linking — upcoming) ───────────────────────────────────
# Optional. Get free sandbox credentials at https://dashboard.plaid.com
# PLAID_LINK_ENABLED=1 exposes the API once the full link flow is implemented.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# PLAID_LINK_ENABLED=0

# ── Google Calendar ───────────────────────────────────────────────────────────
# ICS import works without OAuth. OAuth sync requires all three:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_OAUTH_ENABLED=1
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json
GOOGLE_CALENDAR_ID=primary

# ── Agent approvals (human-in-the-loop queue — upcoming) ──────────────────────
# Audit history at GET /api/approvals/history stays on. Pending approve/reject
# routes return 404 until this is enabled.
# APPROVALS_HITL_ENABLED=0

# ── Error Tracking (Sentry — recommended) ─────────────────────────────────────
# We are using TWO separate Sentry projects (recommended):
#   1. orryon-frontend (Next.js)
#   2. orryon-backend (FastAPI/Python)
#
# Get DSNs from: https://sentry.io → Your projects → Project Settings → Client Keys (DSN)
#
# Backend DSN (set in Railway variables):
SENTRY_DSN=https://YOUR_BACKEND_KEY@oXXXXXX.ingest.us.sentry.io/YYYYYYY
#
# Frontend DSN (set in Vercel as NEXT_PUBLIC_SENTRY_DSN):
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_FRONTEND_KEY@oXXXXXX.ingest.us.sentry.io/ZZZZZZZ

# ── Frontend (set in Vercel environment variables) ────────────────────────────
# Required on Vercel: proxy /api/* to your Railway backend (no NEXT_PUBLIC_API_URL needed for REST).
# BACKEND_URL=https://your-api.up.railway.app
# Optional: same URL for WebSocket chat (otherwise chat uses SSE through the proxy).
# NEXT_PUBLIC_API_URL=https://your-api.up.railway.app
# NEXT_PUBLIC_APP_URL=https://orryon.vercel.app
# Desktop installers (Orryon avatar icon) — host under /downloads or GitHub Releases
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_BASE=https://orryon.vercel.app/downloads
# Required on Vercel for Mac download (upload Orryon-mac.dmg to GitHub Releases first):
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_MAC=https://github.com/YOUR_ORG/orryon/releases/download/v1.0.0/Orryon-mac.dmg
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_WINDOWS=https://github.com/YOUR_ORG/orryon/releases/download/desktop-v1.0.0/Orryon-windows.exe
# NEXT_PUBLIC_DESKTOP_DOWNLOAD_LINUX=https://github.com/YOUR_ORG/orryon/releases/download/desktop-v1.0.0/Orryon-linux.AppImage
# Tier price IDs (Vercel frontend — must match Railway values above)
# NEXT_PUBLIC_STRIPE_PRICE_PRO_MONTHLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_PRO_ANNUAL=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_MONTHLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_ANNUAL=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_PLUS_MONTHLY=price_xxx
# NEXT_PUBLIC_STRIPE_PRICE_PREMIUM_PLUS_ANNUAL=price_xxx
# NEXT_PUBLIC_SENTRY_DSN=https://YOUR_FRONTEND_KEY@oXXXXXX.ingest.us.sentry.io/ZZZZZZZ
# UPSTASH_REDIS_REST_URL=https://<region>.upstash.io
# UPSTASH_REDIS_REST_TOKEN=<rest token from the Upstash console>

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to require JWT_SECRET and suppress dev-only affordances.
# Any value other than "development"/"dev"/"local" is treated as remote (no
# on-screen OTP fallback, demo mode disabled).
NODE_ENV=development
# Opt in to unauthenticated demo login (only honoured when NODE_ENV is local).
# ENABLE_DEMO=1
# Railway sets PORT automatically — no need to set manually.
# PORT=8000
