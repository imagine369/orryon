# ── Grok (xAI) — the AI behind orryon ─────────────────────────────────────────
# REQUIRED. Get your API key at: https://console.x.ai
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Recommended: grok-3-mini (fast + affordable), grok-3 (smarter, slower)
GROK_MODEL=grok-3-mini

# ── Authentication ─────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# In dev mode, an ephemeral secret is auto-generated (tokens won't survive restarts).
JWT_SECRET=

# ── Email / SMTP (for OTP sign-in codes + notifications) ─────────────────────
# If left blank, verification codes are shown on-screen (local dev only).
#
# Gmail (recommended):
#   1. Enable 2FA on your Google account
#   2. myaccount.google.com → Security → App Passwords → generate one
#   3. Paste the 16-char App Password as SMTP_PASS (spaces are fine)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=you@gmail.com
#
# Other providers:
#   Outlook : SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
#   iCloud  : SMTP_HOST=smtp.mail.me.com       SMTP_PORT=587
#   Yahoo   : SMTP_HOST=smtp.mail.yahoo.com    SMTP_PORT=587

# ── URLs ──────────────────────────────────────────────────────────────────────
# APP_URL is used for share links and Stripe return URLs.
# FRONTEND_URL is used for CORS and should match where your Next.js app runs.
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────────────────────
# Path to the SQLite file. In production (e.g. Render), use a persistent disk.
DB_PATH=finance.db

# ── Security ───────────────────────────────────────────────────────────────────
# Optional Fernet key for encrypting sensitive DB fields at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Stripe (subscription billing) ─────────────────────────────────────────────
# Optional. Set up at https://dashboard.stripe.com
# Test keys start with sk_test_ / pk_test_
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=price_xxx
STRIPE_PRICE_ANNUAL=price_yyy

# ── Plaid (bank account linking — upcoming) ───────────────────────────────────
# Optional. Get free sandbox credentials at https://dashboard.plaid.com
# See backend/routers/connections.py for the integration roadmap.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# ── Google Calendar (optional) ────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json
GOOGLE_CALENDAR_ID=primary

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to disable demo mode, require JWT_SECRET, etc.
NODE_ENV=development
