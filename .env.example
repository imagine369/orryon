# ── LLM Configuration ──────────────────────────────────────────────────────────
# Only Grok (xAI) is supported. OpenAI is intentionally not used.
LLM_PROVIDER=grok

# ── Grok (xAI) ─────────────────────────────────────────────────────────────────
# Get your API key at: https://console.x.ai
XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "grok-latest" always auto-upgrades to xAI's newest model — no changes needed.
# Pin to e.g. "grok-3" if you want a stable, predictable version.
GROK_MODEL=grok-latest

# ── Email / SMTP (for OTP sign-in verification codes) ─────────────────────────
# If left blank, verification codes are shown on-screen (local dev only).
#
# Gmail (recommended):
#   1. Enable 2FA on your Google account
#   2. myaccount.google.com → Security → App Passwords → generate one
#   3. Paste the 16-char App Password as SMTP_PASS (spaces are fine)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM=you@gmail.com
#
# Other providers:
#   Outlook : SMTP_HOST=smtp-mail.outlook.com  SMTP_PORT=587
#   iCloud  : SMTP_HOST=smtp.mail.me.com       SMTP_PORT=587
#   Yahoo   : SMTP_HOST=smtp.mail.yahoo.com    SMTP_PORT=587

# ── Plaid (Bank / Credit / Investment aggregation) ─────────────────────────────
# Get free sandbox credentials at https://dashboard.plaid.com
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Generate a sandbox access token via Plaid Quickstart:
# https://github.com/plaid/quickstart
PLAID_ACCESS_TOKEN=access-sandbox-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Market Data ────────────────────────────────────────────────────────────────
# Polygon.io API key (optional; yfinance is used as free fallback)
POLYGON_API_KEY=

# ── Google Calendar (optional) ─────────────────────────────────────────────────
# Download credentials.json from Google Cloud Console:
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CALENDAR_CREDENTIALS=credentials.json
GOOGLE_CALENDAR_TOKEN=token.json
GOOGLE_CALENDAR_ID=primary

# ── Local Storage ──────────────────────────────────────────────────────────────
DB_PATH=finance.db
NOTES_DIR=notes
ICS_CALENDAR_PATH=calendar.ics

# ── Security ───────────────────────────────────────────────────────────────────
# Optional Fernet key for encrypting sensitive DB fields at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── User ───────────────────────────────────────────────────────────────────────
USER_ID=default_user

# ── Public share links (Linktree-style ?links= token URLs) ─────────────────────
# Set to your deployed URL in production (no trailing slash).
APP_URL=http://localhost:8501
