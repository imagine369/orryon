# Copy to desktop/.env.signing (gitignored) for local signed builds.
# Requires Apple Developer Program membership ($99/year).

# Apple ID email + app-specific password (https://appleid.apple.com → App-Specific Passwords)
APPLE_ID=you@example.com
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Team ID — developer.apple.com → Membership → Team ID (10 characters)
APPLE_TEAM_ID=XXXXXXXXXX

# Developer ID Application certificate exported as .p12 from Keychain Access
CSC_LINK=/absolute/path/to/DeveloperIDApplication.p12
CSC_KEY_PASSWORD=your-p12-export-password

# App URL baked into the shell
ORRYON_APP_URL=https://www.orryon.com
