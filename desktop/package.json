{
  "name": "orryon-desktop",
  "version": "1.0.0",
  "description": "Orryon desktop app",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.orryon.app",
    "productName": "Orryon",
    "directories": {
      "output": "dist"
    },
    "files": ["main.js", "package.json", "build/icon.png"],
    "dmg": {
      "title": "Orryon"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": ["dmg"],
      "artifactName": "Orryon-mac.${ext}"
    },
    "win": {
      "icon": "build/icon.png",
      "target": ["nsis"],
      "artifactName": "Orryon-windows.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "target": ["AppImage"],
      "category": "Office",
      "artifactName": "Orryon-linux.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
